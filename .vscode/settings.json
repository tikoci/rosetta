{
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "editor.defaultFormatter": "biomejs.biome",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "files.exclude": {
    "**/*.db-shm": true,
    "**/*.db-wal": true,
    "box/": true
  },
  "search.exclude": {
    "ros-help.db": true,
    "ros-html-assessment.json": true,
    "box/": true,
    "bun.lock": true
  },
  "biome.lsp.bin": "node_modules/@biomejs/biome/bin/biome",
  "markdown.validate.ignoredLinks": [
    "../CLAUDE.md",
    "../DESIGN.md",
    "../BACKLOG.md"
  ],
  // markdownlint extension auto-reads .markdownlint.yaml + .markdownlint-cli2.yaml
  // + .markdownlintignore, so the editor Problems pane matches `make lint`'s
  // markdownlint-cli2 run (LLM instruction files, briefings/, tasks/, fixtures/,
  // and the manual/ cache all excluded). cSpell auto-reads cspell.json +
  // project-words.txt for the same reason — surfaced as warnings, not red errors.
  "cSpell.diagnosticLevel": "Warning",
  "cSpell.enabledFileTypes": {
    "markdown": true,
    "typescript": true,
    "json": true,
    "yaml": true
  },
  "chat.tools.terminal.autoApprove": {
    "uname": true
  }
}
