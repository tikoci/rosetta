node_modules/
bun.lock

# Python (archival scripts)
__pycache__/
*.pyc

# OS
.DS_Store

# Build output
dist/
*.bun-build
images/
.image-build/

# potentially ros-help.db.gz from `gh` ops
ros-help.db.gz

